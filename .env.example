# Copy to .env for local development. Never commit .env.
# docker-compose.yml reads this file; CI and Render set these variables directly.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (Render sets RENDER_EXTERNAL_HOSTNAME itself; it is added to
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS automatically):
# DJANGO_HSTS_SECONDS=86400
# LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Your time zone: sets "today" for default dates and the calendar for stats
TIME_ZONE=America/Los_Angeles

# --- Database ---
# Local (docker compose). Neon in production: postgres://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgres://shelfwise:shelfwise@localhost:5432/shelfwise
DB_CONN_MAX_AGE=60
# Credentials used by the postgres container itself
POSTGRES_USER=shelfwise
POSTGRES_PASSWORD=shelfwise
POSTGRES_DB=shelfwise

# --- Redis (local Celery only, Phase 2+) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT lifetimes) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Requests per client per period to sign-up, login and refresh (DRF rate format)
AUTH_THROTTLE_RATE=10/minute
# Book searches per user per period (protects the Google Books quota)
BOOK_SEARCH_THROTTLE_RATE=30/minute
# Set to false in production once your account exists
ALLOW_SIGNUP=true

# --- Reading logs ---
# Most pages that can be logged for one book on one day (typo guard)
MAX_PAGES_PER_DAY=2000

# --- External APIs ---
# https://developers.google.com/books/docs/v1/using#APIKey (1,000 requests/day)
GOOGLE_BOOKS_API_KEY=
# ISO 639-1 language for book search (Google Books langRestrict)
BOOK_SEARCH_LANGUAGE=en
# Sent to Open Library, which asks clients to identify themselves
OPEN_LIBRARY_USER_AGENT=Shelfwise/0.1 (+https://github.com/jcchang06/shelfwise)

# --- Frontend (Vite exposes only VITE_* variables to the browser) ---
VITE_API_BASE_URL=http://localhost:8000/api
